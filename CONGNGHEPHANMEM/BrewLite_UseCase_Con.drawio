  <diagram id="page-trace" name="Đối chiếu UC ↔ Web ↔ API">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="tr-title" value="Đối chiếu use case ↔ trang web ↔ API" style="text;html=1;align=left;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="tr-table" value="&lt;table border=&#39;1&#39; cellpadding=&#39;6&#39; cellspacing=&#39;0&#39; width=&#39;100%&#39; style=&#39;border-collapse:collapse;font-size:12px;border-color:#E5D9CD&#39;&gt;&lt;tr style=&#39;background:#6F4E37;color:#fff&#39;&gt;&lt;th align=&#39;left&#39;&gt;UC&lt;/th&gt;&lt;th align=&#39;left&#39;&gt;Chức năng&lt;/th&gt;&lt;th align=&#39;left&#39;&gt;Trạng thái&lt;/th&gt;&lt;th align=&#39;left&#39;&gt;Trang web&lt;/th&gt;&lt;th align=&#39;left&#39;&gt;API / Backend&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;1.1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Đăng ký&lt;/td&gt;&lt;td style=&#39;background:#E3F2E7&#39;&gt;Đã có&lt;/td&gt;&lt;td&gt;/register&lt;/td&gt;&lt;td&gt;POST /auth/register&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;1.2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Đăng nhập&lt;/td&gt;&lt;td style=&#39;background:#E3F2E7&#39;&gt;Đã có&lt;/td&gt;&lt;td&gt;/login&lt;/td&gt;&lt;td&gt;POST /auth/login · GET /auth/me&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;1.2.3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Quên mật khẩu&lt;/td&gt;&lt;td style=&#39;background:#E3EEFB&#39;&gt;Chỉ có giao diện&lt;/td&gt;&lt;td&gt;/forgotpassword&lt;/td&gt;&lt;td&gt;Chưa có&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;1.3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Đăng xuất&lt;/td&gt;&lt;td style=&#39;background:#E3F2E7&#39;&gt;Đã có&lt;/td&gt;&lt;td&gt;Menu tài khoản ở Header&lt;/td&gt;&lt;td&gt;Xóa token ở trình duyệt&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;2.1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Xem menu (tìm kiếm, lọc danh mục)&lt;/td&gt;&lt;td style=&#39;background:#E3F2E7&#39;&gt;Đã có&lt;/td&gt;&lt;td&gt;/menu&lt;/td&gt;&lt;td&gt;GET /products&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;2.2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Chi tiết, chọn size / topping / đường / đá&lt;/td&gt;&lt;td style=&#39;background:#E3F2E7&#39;&gt;Đã có&lt;/td&gt;&lt;td&gt;/menu/[id]&lt;/td&gt;&lt;td&gt;GET /products/:id&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;2.3&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Xem khuyến mãi&lt;/td&gt;&lt;td style=&#39;background:#E3F2E7&#39;&gt;Đã có&lt;/td&gt;&lt;td&gt;/promotions&lt;/td&gt;&lt;td&gt;GET /promotions&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;3.1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Quản lý giỏ hàng&lt;/td&gt;&lt;td style=&#39;background:#E3F2E7&#39;&gt;Đã có&lt;/td&gt;&lt;td&gt;/cart&lt;/td&gt;&lt;td&gt;store/cart.ts (trình duyệt)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;3.1.7&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Áp mã khuyến mãi&lt;/td&gt;&lt;td style=&#39;background:#E3F2E7&#39;&gt;Đã có&lt;/td&gt;&lt;td&gt;/cart&lt;/td&gt;&lt;td&gt;POST /promotions/validate&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;3.1.8&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Dùng điểm thưởng&lt;/td&gt;&lt;td style=&#39;background:#E3F2E7&#39;&gt;Đã có&lt;/td&gt;&lt;td&gt;/cart&lt;/td&gt;&lt;td&gt;Tính lại ở máy chủ khi POST /orders&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;4.1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Đặt hàng (kiểm tra tồn kho)&lt;/td&gt;&lt;td style=&#39;background:#E3F2E7&#39;&gt;Đã có&lt;/td&gt;&lt;td&gt;/checkout&lt;/td&gt;&lt;td&gt;POST /orders&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;4.2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Thanh toán (idempotent, cộng điểm)&lt;/td&gt;&lt;td style=&#39;background:#E3F2E7&#39;&gt;Đã có&lt;/td&gt;&lt;td&gt;/checkout · /orders/[id]/success · /orders/[id]/failed&lt;/td&gt;&lt;td&gt;POST /payments + Idempotency-Key&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;5.1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Xem lịch sử đơn&lt;/td&gt;&lt;td style=&#39;background:#E3F2E7&#39;&gt;Đã có&lt;/td&gt;&lt;td&gt;/orders&lt;/td&gt;&lt;td&gt;GET /orders/me&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;5.2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Chi tiết đơn, theo dõi tiến trình&lt;/td&gt;&lt;td style=&#39;background:#E3F2E7&#39;&gt;Đã có&lt;/td&gt;&lt;td&gt;/orders/[id]&lt;/td&gt;&lt;td&gt;GET /orders/:id&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;5.2.5&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Hủy đơn (khách)&lt;/td&gt;&lt;td style=&#39;background:#E3F2E7&#39;&gt;Đã có&lt;/td&gt;&lt;td&gt;/orders/[id] · /orders/[id]/failed&lt;/td&gt;&lt;td&gt;POST /orders/:id/cancel&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;5.1.6&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Đặt lại đơn cũ&lt;/td&gt;&lt;td style=&#39;background:#F2F2F2&#39;&gt;Chưa làm&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;6.1&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Xem đơn cần pha&lt;/td&gt;&lt;td style=&#39;background:#F2F2F2&#39;&gt;Chưa làm&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;Chưa có API liệt kê đơn cho nhân viên&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;6.2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Cập nhật trạng thái đơn&lt;/td&gt;&lt;td style=&#39;background:#FFF0C9&#39;&gt;Có API, chưa có giao diện&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;PATCH /orders/:id/status (role STAFF)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;7.1 – 7.4&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Báo cáo, quản lý sản phẩm / khuyến mãi / nhân viên&lt;/td&gt;&lt;td style=&#39;background:#F2F2F2&#39;&gt;Chưa làm&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;Chỉ qua Prisma Studio, seed.ts&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1300" height="706" as="geometry" />
        </mxCell>
        <mxCell id="tr-hint" value="Khi sửa web hoặc API, cập nhật dòng tương ứng ở đây và sửa trang sơ đồ UC-x có cùng mã." style="text;html=1;align=left;fontSize=12;fontColor=#74665B;" vertex="1" parent="1">
          <mxGeometry x="40" y="786" width="900" height="24" as="geometry" />
        </mxCell>
